# PROXSYNTH PROXY ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Forward Interception Proxy (:8088)
HTTP_PROXY=http://127.0.0.1:8088
HTTPS_PROXY=http://127.0.0.1:8088
http_proxy=http://127.0.0.1:8088
https_proxy=http://127.0.0.1:8088
ALL_PROXY=http://127.0.0.1:8088
all_proxy=http://127.0.0.1:8088

# CA Certificate trust paths (auto-generated by ca_manager on first startup)
REQUESTS_CA_BUNDLE=.proxynth_ca/proxynth_ca.crt
SSL_CERT_FILE=.proxynth_ca/proxynth_ca.crt
CURL_CA_BUNDLE=.proxynth_ca/proxynth_ca.crt

# Testing transport overrides (disables verification noise for scoped targets)
PYTHONHTTPSVERIFY=0
CURL_INSECURE=1
NODE_TLS_REJECT_UNAUTHORIZED=0

# Server & Workspace Options
# PROXSYNTH_PORT=8000
# PROXSYNTH_PROXY_PORT=8088
# PROXSYNTH_PROJECT=default
# PROXSYNTH_TOOL_MODE=hexagon
